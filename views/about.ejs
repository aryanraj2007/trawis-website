<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>

<body>
  <%- include('partials/header') %>

  <main>
    <!-- ABOUT HERO -->
    <section class="section section-dark about-hero">
      <div class="hero-bg-glow"></div>

      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-7">

            <h1 class="hero-title animate-up delay-1">
              Building The <span>Intelligence Layer</span> For Modern Energy Trading.
            </h1>

            <p class="hero-subtitle animate-up delay-2">
              TraWis helps Oil &amp; Gas operators bring pricing, risk, logistics,
              market signals, and enterprise data into one AI-powered decision layer.
            </p>

            <div class="hero-actions animate-up delay-3">
              <a href="/demo" class="btn btn-brand btn-lg">Schedule Demo</a>
              <a href="/leadership" class="btn btn-ghost btn-lg">Meet Leadership</a>
            </div>
          </div>

          <div class="col-lg-5">
            <div class="about-hero-visual animate-up delay-2">
              <img
                src="/assets/about-hero.png"
                alt="Trade intelligence"
                class="about-hero-img"
              >

              <div class="about-hero-card">
                <span>Purpose-built for</span>
                <strong>Oil &amp; Gas Operators</strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>



<!-- WHO WE ARE -->
<section class="section section-soft who-we-are-section">
  <div class="container">
    <div class="row align-items-start gy-5 gx-lg-5">
      <!-- LEFT -->
      <div class="col-lg-5">
        <div class="who-we-are-intro">
          <div class="section-kicker">Who We Are</div>

          <h2 class="section-title">
            An AI-First Company Focused On
            <span class="text-brand">Trade Desk Transformation.</span>
          </h2>

          <p class="section-text">
            TraWis helps energy trading teams move from fragmented information
            to faster, explainable, and governed decisions.
          </p>

          <div class="who-we-are-callout">
            <div class="who-we-are-callout-icon">
              <i class="bi bi-lightning-charge-fill"></i>
            </div>

            <div>
              <span>Our Focus</span>
              <strong>
                Connecting market intelligence, operational realities,
                and enterprise execution.
              </strong>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT -->
      <div class="col-lg-7">
        <div class="who-we-are-cards">
          <article class="who-we-are-card">
            <div class="who-we-are-number">1</div>

            <div>
              <h3>The Challenge We Solve</h3>

              <p>
                Energy trade desks must make fast, accurate decisions across pricing,
                exposure, logistics, and risk, often using fragmented information
                and manual analysis.
              </p>
            </div>
          </article>

          <article class="who-we-are-card">
            <div class="who-we-are-number">2</div>

            <div>
              <h3>The Gap In Today’s Landscape</h3>

              <p>
                Operators already have powerful systems for execution, accounting,
                risk reporting, and enterprise operations. The decision layer,
                however, often remains spread across spreadsheets, dashboards,
                market feeds, and disconnected workflows.
              </p>
            </div>
          </article>

          <article class="who-we-are-card">
            <div class="who-we-are-number">3</div>

            <div>
              <h3>Where TraWis Fits</h3>

              <p>
                TraWis sits above ETRM, CTRM, ERP, logistics, contract, and market-data
                platforms to create one unified intelligence layer for the trading function.
              </p>
            </div>
          </article>
        </div>
      </div>
    </div>

    <!-- POSITIONING STRIP -->
    <div class="who-we-are-platform">
      <div class="who-we-are-platform-item">
        <i class="bi bi-database-fill"></i>
        <span>ETRM / CTRM</span>
      </div>

      <div class="who-we-are-platform-item">
        <i class="bi bi-building-gear"></i>
        <span>ERP &amp; Operations</span>
      </div>

      <div class="who-we-are-platform-item">
        <i class="bi bi-truck"></i>
        <span>Logistics &amp; Contracts</span>
      </div>

      <div class="who-we-are-platform-item">
        <i class="bi bi-graph-up-arrow"></i>
        <span>Market Intelligence</span>
      </div>

      <div class="who-we-are-platform-arrow">
        <i class="bi bi-arrow-right"></i>
      </div>

      <div class="who-we-are-platform-core">
        <span>TraWis</span>
        <strong>Unified Decision Intelligence</strong>
      </div>
    </div>
  </div>
</section>





<!-- MISSION -->
<section class="section mission-section">
  <div class="container">
    <div class="section-heading text-center mission-heading">
      <div class="section-kicker">Our Mission</div>

      <h2 class="section-title">
        Turn Trading Complexity<br>
        Into Confident Action.
      </h2>

      <p class="section-text mx-auto">
        We believe traders, pricers, schedulers, and risk managers should not have to
        chase signals across systems. They should have one trusted layer that brings
        the right data, recommendations, and reasoning together.
      </p>
    </div>

    <div class="mission-card-grid">
      <article
        class="differentiator-card mission-card"
        style="background-image: url('/assets/unify-signals.jpeg');"
      >
        <div class="differentiator-card-overlay"></div>

        <div class="differentiator-card-content">
          <!-- <div class="differentiator-number">1</div> -->

          <h3>Unify Signals</h3>

          <p>
            Bring internal operator data and external market signals into one
            connected decision view.
          </p>
        </div>
      </article>

      <article
        class="differentiator-card mission-card"
        style="background-image: url('/assets/predict-earlier.jpeg');"
      >
        <div class="differentiator-card-overlay"></div>

        <div class="differentiator-card-content">
          <!-- <div class="differentiator-number">2</div> -->

          <h3>Predict Earlier</h3>

          <p>
            Use AI and ML models to identify pricing patterns, volatility signals,
            and market shifts.
          </p>
        </div>
      </article>

      <article
        class="differentiator-card mission-card"
        style="background-image: url('/assets/recommend-action.jpeg');"
      >
        <div class="differentiator-card-overlay"></div>

        <div class="differentiator-card-content">
          <!-- <div class="differentiator-number">3</div> -->

          <h3>Recommend Action</h3>

          <p>
            Support buy, sell, hedge, pricing, scheduling, and risk actions with
            explainable recommendations.
          </p>
        </div>
      </article>

      <article
        class="differentiator-card mission-card"
        style="background-image: url('/assets/govern-decisions.jpeg');"
      >
        <div class="differentiator-card-overlay"></div>

        <div class="differentiator-card-content">
          <!-- <div class="differentiator-number">4</div> -->

          <h3>Govern Decisions</h3>

          <p>
            Provide workflow-based approvals, audit trails, and controls for
            enterprise adoption.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>



    <!-- WHY TRAWis EXISTS -->
    <section class="section section-dark">
      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-6">
            <div class="section-kicker">Why We Exist</div>

            <h2 class="section-title text-white">
              Energy Trading Has Too Much Data, But Not Enough Decision Intelligence.
            </h2>

            <p class="section-text text-white-70">
              Trading teams are expected to act quickly in a market shaped by price volatility,
              supply disruptions, geopolitical events, weather, logistics constraints, and
              constantly changing risk exposure.
            </p>

            <p class="section-text text-white-70">
              TraWis exists to reduce that complexity by turning fragmented data into
              predictive, explainable, and role-based recommendations.
            </p>
          </div>

          <div class="col-lg-6">
            <div class="about-image-stack">
              <img
                src="/assets/hands-graph.jpeg"
                alt="Market signals placeholder"
                class="about-stack-img about-stack-img-main"
              >

              <img
                src="/assets/world-graph.png"
                alt="Risk view placeholder"
                class="about-stack-img about-stack-img-small"
              >
            </div>
          </div>
        </div>
      </div>
    </section>


 <!-- WHAT MAKES US DIFFERENT -->
<section class="section section-soft difference-section">
  <div class="container">
    <div class="section-heading text-center">
      <div class="section-kicker">What Makes Us Different</div>

      <h2 class="section-title">
        Built For The Realities Of Enterprise Trading.
      </h2>

      <p class="section-text mx-auto">
        TraWis is not just a dashboard or chatbot. It is designed as a governed,
        integrated, and explainable intelligence platform for enterprise operators.
      </p>
    </div>

    <div class="row g-4 justify-content-center">
      <div class="col-lg-4 col-md-6">
        <article class="difference-card">
          <div class="difference-icon-wrap">
            <img
              src="/assets/domain-first-design.png"
              alt="Domain-first design icon"
              class="difference-icon-img"
            />
          </div>

          <h3>Domain-First Design</h3>

          <p>
            Built around real trading desk personas including traders, pricers,
            schedulers, risk managers, and commercial teams.
          </p>
        </article>
      </div>

      <div class="col-lg-4 col-md-6">
        <article class="difference-card">
          <div class="difference-icon-wrap">
            <img
              src="/assets/system-aware-intelligence.png"
              alt="System-aware intelligence icon"
              class="difference-icon-img"
            />
          </div>

          <h3>System-Aware Intelligence</h3>

          <p>
            Designed to connect with existing ETRM, CTRM, ERP, logistics,
            contract, and market data environments.
          </p>
        </article>
      </div>

      <div class="col-lg-4 col-md-6">
        <article class="difference-card">
          <div class="difference-icon-wrap">
            <img
              src="/assets/explainable-recommendations.png"
              alt="Explainable recommendations icon"
              class="difference-icon-img"
            />
          </div>

          <h3>Explainable Recommendations</h3>

          <p>
            Recommendations are supported by confidence scores, reasoning,
            governance, and auditability.
          </p>
        </article>
      </div>
    </div>
  </div>
</section>


    <!-- IMPACT BAND -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Designed For Impact</div>

          <h2 class="section-title">
            Helping trading teams move faster with better control.
          </h2>
        </div>

        <div class="impact-grid">
          <div class="impact-card">
            <strong>40–50</strong>
            <span>%</span>
            <p>Faster decision cycles</p>
          </div>

          <div class="impact-card">
            <strong>2–3</strong>
            <span>%</span>
            <p>Margin improvement via early signal detection</p>
          </div>

          <div class="impact-card">
            <strong>20–40</strong>
            <span>%</span>
            <p>Reduction in exposure risk</p>
          </div>

          <div class="impact-card">
            <strong>25</strong>
            <span>%</span>
            <p>Fewer manual tasks through automation</p>
          </div>
        </div>
      </div>
    </section>


<!-- ENTERPRISE READINESS -->
<section class="section section-soft">
  <div class="container">
    <div class="row align-items-center gy-5">
      <div class="col-lg-5">
        <img
          src="/assets/enterprise-ready.jpeg"
          alt="Enterprise-ready trade intelligence platform"
          class="about-platform-img"
        >
      </div>

      <div class="col-lg-7">
        <div class="section-kicker">Enterprise Ready</div>

        <h2 class="section-title">
          Built for complex operator environments.
        </h2>

        <p class="section-text">
          TraWis is designed for enterprise trading teams that need more than a dashboard.
          The platform brings together secure integration, workflow governance,
          explainable recommendations, and audit-ready decision trails.
        </p>

        <p class="section-text">
          From predictive pricing to risk visibility and role-based recommendations,
          TraWis helps operators start with focused use cases and scale across the
          trading function over time.
        </p>

        <div class="hero-actions">
          <a href="/leadership" class="btn btn-brand btn-lg">Meet Leadership</a>
          <a href="/platform" class="btn btn-outline-dark btn-lg">Explore Platform</a>
        </div>
      </div>
    </div>
  </div>
</section>


    <!-- CTA -->
    <section class="section demo-cta">
      <div class="container">
        <div class="cta-card">
          <div>
            <div class="section-kicker">Ready To Learn More?</div>

            <h2>See How TraWis Can Support Your Trading Function.</h2>

            <p>
              Schedule a conversation to explore product vision, pilot opportunities,
              enterprise architecture, and use cases for your trade desk.
            </p>
            <br>
            <a href="/demo" class="btn btn-brand btn-lg">
            Schedule a Demo
          </a>
          </div>

        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>

<body>
  <%- include('partials/header') %>

  <main class="error-404-page">
    <div class="error-404-card">
      <div class="error-code">404</div>
      <h1>Page not found</h1>
      <p class="error-404-copy">
        The page you are looking for is not available yet or may have moved.
        Use the links below to return home or explore another section of TraWis.
      </p>
      <div class="error-actions">
        <a href="/" class="btn btn-brand">Back to home</a>
        <a href="/product" class="btn btn-ghost">Explore product</a>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>

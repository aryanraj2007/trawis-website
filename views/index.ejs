    <!-- PROBLEM -->
    <section class="section problem-section" id="problem">
      <div class="problem-cutout problem-cutout-1" aria-hidden="true">
        <img src="/assets/dashboard.png" alt="">
      </div>

      <div class="problem-cutout problem-cutout-2" aria-hidden="true">
        <img src="/assets/stock-graph.jpg" alt="">
      </div>

      <div class="problem-cutout problem-cutout-3" aria-hidden="true">
        <img src="/assets/spreadsheet.jpg" alt="">
      </div>

      <div class="container problem-container">
        <div class="section-heading text-center">
          <div class="section-kicker">The challenge</div>

          <h2 class="section-title">
            The Energy Market Runs in Trillions. Decisions Still Run in Silos.
          </h2>

          <p class="section-text mx-auto">
            Critical trading intelligence remains fragmented across ETRM platforms,
            ERP systems, spreadsheets, and workflows, making it harder to act with
            speed, confidence, and visibility.
          </p>
        </div>

        <div class="row g-4">
          <div class="col-md-6 col-lg-3">
            <article class="feature-card problem-card">
              <div class="problem-number">1</div>
              <h3>Fragmented intelligence</h3>
              <p>
                Market, operational, logistics, contract, and risk data remain spread
                across disconnected systems.
              </p>
            </article>
          </div>

          <div class="col-md-6 col-lg-3">
            <article class="feature-card problem-card">
              <div class="problem-number">2</div>
              <h3>Delayed decisions</h3>
              <p>
                Teams lose valuable time gathering, validating, and reconciling data
                before they can act.
              </p>
            </article>
          </div>

          <div class="col-md-6 col-lg-3">
            <article class="feature-card problem-card">
              <div class="problem-number">3</div>
              <h3>Limited visibility</h3>
              <p>
                Exposure, position, margin, and operational constraints are often viewed
                through separate reports and workflows.
              </p>
            </article>
          </div>

          <div class="col-md-6 col-lg-3">
            <article class="feature-card problem-card">
              <div class="problem-number">4</div>
              <h3>Manual execution</h3>
              <p>
                Spreadsheet-heavy workflows slow down approvals, increase inconsistency,
                and make decision trails harder to audit.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>


    <!-- SOLUTION -->
    <section class="section section-soft">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Meet TraWis</div>

          <h2 class="section-title">
            One Intelligent Decision Layer Above Your Existing ETRM, CTRM, and ERP Systems
          </h2>

          <p class="section-text mx-auto">
            Predictive signals, recommended actions, confidence scores, risk alerts,
            and audit-ready decision trails, all unified in a single AI-powered
            intelligence workbench.
          </p>
        </div>

        <div class="row g-4">
          <div class="col-lg-4">
            <article class="feature-card">
              <div class="feature-icon">1</div>

          </div>

          <div class="col-lg-4">
            <article class="feature-card">
              <div class="feature-icon">3</div>
              <h3>Execute</h3>
              <p>Initiate governed workflows back into ERP and CTRM systems.</p>
            </article>
          </div>
        </div>
      </div>
    </section>



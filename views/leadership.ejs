<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>

<body>
  <%- include('partials/header') %>

  <main>
    <!-- LEADERSHIP HERO -->
    <section class="section section-dark leadership-hero">
      <div class="hero-bg-glow"></div>

      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-7">

            <h1 class="hero-title animate-up delay-1">
              Enterprise Leaders Building The <span>Future Of Trade Intelligence.</span>
            </h1>

            <p class="hero-subtitle animate-up delay-2">
              TraWis is led by a team with deep experience across Oil &amp; Gas,
              SAP, cloud, AI, enterprise architecture, and go-to-market execution.
            </p>

            <div class="hero-actions animate-up delay-3">
              <a href="/demo" class="btn btn-brand btn-lg">Schedule Demo</a>
              <a href="/about" class="btn btn-ghost btn-lg">About TraWis</a>
            </div>
          </div>

          <div class="col-lg-5">
            <div class="leadership-hero-collage animate-up delay-2">
              <img
                src="assets/leadership.png"
                alt="TraWis leadership placeholder"
                class="leadership-hero-img leadership-hero-img-main"
              >

              <img
                src="assets/trade-intel.jpg"
                alt="AI strategy placeholder"
                class="leadership-hero-img leadership-hero-img-small"
              >
            </div>
          </div>
        </div>
      </div>
    </section>


<!-- EXECUTIVE SUMMARY -->
<section class="section section-soft leadership-summary-section">
  <div class="container">
    <div class="row align-items-center gy-5">
      <div class="col-lg-5">
        <div class="section-kicker">Executive Summary</div>

        <h2 class="section-title">
          Built By Operators, Architects, And AI Specialists.
        </h2>
      </div>

      <div class="col-lg-7">
        <div
          class="leadership-summary-visual-card"
          style="background-image: url('/assets/leadership-summary-bg.png');"
        >
          <div class="leadership-summary-overlay"></div>

          <div class="leadership-summary-content">
            <p class="leadership-summary-lead">
              TraWis is shaped by a founding team that brings a unique combination of
              industrial grit, enterprise scale, and advanced machine learning expertise.
            </p>

            <p class="leadership-summary-copy">
              At our core are energy operators from global giants, seamlessly blended with
              enterprise technology pioneers. This enables us to zoom out to comprehend
              complex multi-tiered energy supply chains, while simultaneously zooming in
              to the nth layer to deploy high-performance ML models that solve real
              operational bottlenecks.
            </p>

            <div class="leadership-summary-cards">
  <article class="leadership-summary-mini-card">
    <h3>Industrial Grit</h3>
  </article>

  <article class="leadership-summary-mini-card">
    <h3>Enterprise Scale</h3>
  </article>

  <article class="leadership-summary-mini-card">
    <h3>Advanced ML Expertise</h3>
  </article>
</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

    <!-- EXECUTIVE TEAM -->
    <section class="section" id="leadership-team">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Executive Team</div>

          <h2 class="section-title">
            The People Behind TraWis.
          </h2>

          <p class="section-text mx-auto">
            A cross-functional leadership team combining trading domain knowledge,
            enterprise transformation, AI architecture, and customer growth.
          </p>
        </div>

        <div class="row g-4">
          <!-- Prabhakar -->
          <div class="col-md-6 col-lg-4">
            <article class="feature-card leadership-card">
              <div class="leadership-avatar">
                <img
                  src="assets/headshots/prabhakar_headshot.png"
                  alt="Prabhakar Prasad"
                >
              </div>

              <div class="leadership-meta">
                <span class="leadership-role">Chief Executive Officer</span>
                <h3>Prabhakar Prasad</h3>
                <p>
                  Enterprise transformation leader with more than three decades of experience
                  across SAP, global delivery, customer engagement, and business growth.
                </p>
              </div>
            </article>
          </div>

          <!-- Rajesh -->
          <div class="col-md-6 col-lg-4">
            <article class="feature-card leadership-card">
              <div class="leadership-avatar">
                <img
                  src="assets/headshots/rajesh_headshot.png"
                  alt="Rajesh Raj"
                >
              </div>

              <div class="leadership-meta">
                <span class="leadership-role">Chief Operating Officer</span>
                <h3>Rajesh Raj</h3>
                <p>
                  Growth and revenue leader with deep experience building sales,
                  business development, partner, and customer organizations across SAP, IBM, and AWS.
                </p>
              </div>
            </article>
          </div>

          <!-- CTO -->
          <div class="col-md-6 col-lg-4">
            <article class="feature-card leadership-card">
              <div class="leadership-avatar">
                <img
                  src="/assets/headshots/anurag_headshot.png"
                  alt="Chief Technology Officer"
                >
              </div>

              <div class="leadership-meta">
                <span class="leadership-role">Head of Engineering</span>
                <h3>Anurag Garg</h3>
                <p>
                  Seasoned engineering and technology leader with expertise in cloud architecture, end-to-end product development, and AI-powered intelligent decision systems.
                </p>
              </div>
            </article>
          </div>


        </div>
      </div>
    </section>


    <!-- EXPERIENCE BAND -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Leadership Strength</div>

          <h2 class="section-title text-white">
            Enterprise Credibility With Startup Speed.
          </h2>

          <p class="section-text text-white-70 mx-auto">
            TraWis is designed for enterprise adoption from day one: secure architecture,
            integration readiness, workflow governance, explainable AI, and measurable business value.
          </p>
        </div>

        <div class="impact-grid">
          <div class="impact-card leadership-stat-card">
            <strong>30+</strong>
            <p>Years of enterprise transformation leadership</p>
          </div>

          <div class="impact-card leadership-stat-card">
            <strong>AI</strong>
            <p>Product thinking for predictive and agentic decision support</p>
          </div>

          <div class="impact-card leadership-stat-card">
            <strong>O&amp;G</strong>
            <p>Domain focus across trading, risk, logistics, and enterprise systems</p>
          </div>

          <div class="impact-card leadership-stat-card">
            <strong>SAP</strong>
            <p>Deep experience across SAP, ERP, integration, and transformation programs</p>
          </div>
        </div>
      </div>
    </section>


 <!-- VALUES -->
<section class="section section-soft difference-section values-section">
  <div class="container">
    <div class="section-heading text-center">
      <div class="section-kicker">How We Lead</div>

      <h2 class="section-title">
        Built Around Clarity, Trust, And Measurable Impact.
      </h2>
    </div>

    <div class="row g-4 justify-content-center">
      <div class="col-md-6 col-lg-3">
        <article class="difference-card values-card">
          <div class="difference-icon-wrap">
            <img
              src="/assets/customer-obsession.jpeg"
              alt="Customer obsession icon"
              class="difference-icon-img"
            />
          </div>

          <h3>Customer Obsession</h3>

          <p>
            We start with the trading desk problem and work backward from the decision.
          </p>
        </article>
      </div>

      <div class="col-md-6 col-lg-3">
        <article class="difference-card values-card">
          <div class="difference-icon-wrap">
            <img
              src="/assets/enterprise-readiness.jpeg"
              alt="Enterprise readiness icon"
              class="difference-icon-img"
            />
          </div>

          <h3>Enterprise Readiness</h3>

          <p>
            Security, governance, workflow controls, and integration discipline are built in.
          </p>
        </article>
      </div>

      <div class="col-md-6 col-lg-3">
        <article class="difference-card values-card">
          <div class="difference-icon-wrap">
            <img
              src="/assets/explainable-ai.jpeg"
              alt="Explainable AI icon"
              class="difference-icon-img"
            />
          </div>

          <h3>Explainable AI</h3>

          <p>
            Recommendations must be transparent, auditable, and trusted by business users.
          </p>
        </article>
      </div>

      <div class="col-md-6 col-lg-3">
        <article class="difference-card values-card">
          <div class="difference-icon-wrap">
            <img
              src="/assets/speed-to-value.jpeg"
              alt="Speed to value icon"
              class="difference-icon-img"
            />
          </div>

          <h3>Speed To Value</h3>

          <p>
            Customers should be able to start small, validate value, and scale.
          </p>
        </article>
      </div>
    </div>
  </div>
</section>


    <!-- CTA -->
    <section class="section demo-cta">
      <div class="container">
        <div class="cta-card">
          <div>
            <div class="section-kicker">Meet The Team</div>

            <h2>Ready To Discuss TraWis With Our Leadership Team?</h2>

            <p>
              Schedule a conversation to explore the platform vision, product roadmap,
              enterprise architecture, and pilot opportunities.
            </p>
            
            <br><a href="/demo" class="btn btn-brand btn-lg">
                Schedule Demo
            </a>
          </div>

        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
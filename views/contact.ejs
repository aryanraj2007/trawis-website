<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>

<body>
  <%- include('partials/header') %>

  <main>

<!-- CONTACT HERO -->
<section class="contact-hero section-dark">
  <div class="contact-hero-glow"></div>

  <div class="container contact-hero-container">
    <div class="row align-items-center gy-5 gx-lg-5">
      <div class="col-lg-6">
        <div class="contact-hero-copy">
          <h1 class="hero-title contact-hero-title animate-up delay-1">
            Let’s talk about the
            <span>future</span> of <span>trade</span>
            intelligence.
          </h1>

          <p class="hero-subtitle contact-hero-subtitle animate-up delay-2">
            Reach out to discuss TraWis, product demos, pilot opportunities,
            platform questions, or enterprise trading use cases.
          </p>

          <div class="hero-actions animate-up delay-3">
            <a
              href="mailto:info@trawis.com?subject=TraWis Inquiry"
              class="btn btn-brand btn-lg"
            >
              Email Us
            </a>

            <a href="/about" class="btn btn-ghost btn-lg">
              Learn About TraWis
            </a>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="contact-hero-visual animate-up delay-2">
          <div class="contact-image-glow"></div>

          <div class="contact-image-frame">
            <img
              src="/assets/contact-hero.png"
              alt="Future-focused trade intelligence and market growth"
              class="contact-hero-image"
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


    <!-- EMAIL FEATURE SECTION -->
    <section class="section section-soft">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Get in touch</div>

          <h2 class="section-title">
            One email. The right conversation.
          </h2>

          <p class="section-text mx-auto">
            Whether you are exploring predictive pricing, trade recommendations,
            risk visibility, or enterprise deployment, the best way to start is by email.
          </p>
        </div>

        <div class="contact-email-panel">
          <div class="contact-email-icon">
            @
          </div>

          <div class="contact-email-content">
            <span>Email TraWis</span>

            <a href="mailto:info@trawis.com?subject=TraWis Inquiry">
              info@trawis.com
            </a>

            <p>
              For product demos, pilots, partnerships, and enterprise inquiries.
            </p>
          </div>

          <div class="contact-email-actions">
            <a
              href="mailto:info@trawis.com?subject=TraWis Inquiry"
              class="btn btn-brand"
            >
              Send Email
            </a>

            <button
              class="btn btn-outline-dark contact-copy-btn"
              type="button"
              data-email="info@trawis.com"
            >
              Copy Email
            </button>
          </div>
        </div>
      </div>
    </section>


    <!-- CONTACT USE CASES -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">What to contact us about</div>

          <h2 class="section-title">
            Start with the outcome you want to explore.
          </h2>
        </div>

        <div class="row g-4">
          <div class="col-md-6 col-lg-3">
            <article class="feature-card">
              <div class="feature-icon">1</div>
              <h3>Product demo</h3>
              <p>
                See how TraWis supports traders, pricers, schedulers, and risk managers.
              </p>
            </article>
          </div>

          <div class="col-md-6 col-lg-3">
            <article class="feature-card">
              <div class="feature-icon">2</div>
              <h3>Pilot discussion</h3>
              <p>
                Explore a focused use case for pricing, risk, scheduling, or recommendations.
              </p>
            </article>
          </div>

          <div class="col-md-6 col-lg-3">
            <article class="feature-card">
              <div class="feature-icon">3</div>
              <h3>Platform questions</h3>
              <p>
                Discuss integrations, architecture, security, workflow, and deployment needs.
              </p>
            </article>
          </div>

          <div class="col-md-6 col-lg-3">
            <article class="feature-card">
              <div class="feature-icon">4</div>
              <h3>Partnerships</h3>
              <p>
                Connect on strategic, technology, data, or implementation partnerships.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>


    <!-- CTA -->
    <section class="section demo-cta">
      <div class="container">
        <div class="cta-card">
          <div>
            <div class="section-kicker">Ready when you are</div>

            <h2>Have a question about TraWis?</h2>

            <p>
              Send us an email and we’ll route your inquiry to the right team.
            </p>
          </div>

          <a href="mailto:info@trawis.com?subject=TraWis Inquiry" class="btn btn-brand btn-lg">
            info@trawis.com
          </a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
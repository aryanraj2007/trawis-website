<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="https://cdn.quilljs.com/1.3.6/quill.snow.css">
</head>
<body>

  <div class="admin-wrapper">
    <%- include('../partials/admin-sidebar', { currentUser: currentUser, activeSection: 'posts' }) %>

    <!-- MAIN CONTENT -->
    <main class="admin-content">
      <div class="content-header">
        <div>
          <h2 class="content-title"><%= post ? 'Edit Blog Post' : 'Create New Blog Post' %></h2>
          <p class="text-muted mb-0" style="font-size:0.9rem;">Compose and manage articles with a consistent admin interface.</p>
        </div>
        <div>
          <a href="/admin/dashboard" class="btn btn-brand btn-nav-custom"><i class="bi bi-arrow-left me-1"></i> Back to Dashboard</a>
        </div>
      </div>

      <div class="admin-card">
        <form action="<%= post ? '/admin/posts/' + post.id + '/edit' : '/admin/posts' %>" method="POST" enctype="multipart/form-data">
          <div class="mb-4">
            <label for="title" class="form-label-custom">Post Title</label>
            <input type="text" id="title" name="title" class="form-control form-control-custom" placeholder="Enter a concise, descriptive title" value="<%= post ? post.title : '' %>" required>
          </div>

          <div class="mb-4">
            <label for="coverImage" class="form-label-custom">Cover Image</label>
            <input type="file" id="coverImage" name="coverImage" class="form-control form-control-custom" accept="image/*">
            <div class="form-text text-muted fs-8">Accepted: JPG, PNG, WEBP, GIF. Max 5MB.</div>
            <% if (post && post.cover_image) { %>
              <div class="mt-2">
                <span class="text-muted small">Current image:</span>
                <img src="<%= post.cover_image %>" alt="Cover" class="cover-image-preview">
              </div>
            <% } %>
          </div>

          <div class="mb-4">
            <label for="editor" class="form-label-custom">Article Body</label>
            <div id="editor" class="editor-container"></div>
            <textarea id="content" name="content" class="d-none"><%= post ? post.content : '' %></textarea>
          </div>

          <div class="row align-items-center mt-3">
            <div class="col-md-4 mb-3 mb-md-0">
              <label for="status" class="form-label-custom">Publish Status</label>
              <select id="status" name="status" class="form-select form-select-custom">
                <option value="draft" <%= post && post.status === 'draft' ? 'selected' : '' %>>Draft</option>
                <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Published</option>
              </select>
            </div>
            <div class="col-md-8 text-md-end">
              <a href="/admin/dashboard" class="btn btn-secondary btn-nav-custom me-2">Cancel</a>
              <button type="submit" class="btn btn-brand btn-nav-custom"><i class="bi bi-save-fill"></i> <%= post ? 'Save Changes' : 'Publish Post' %></button>
            </div>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
  <script>
    const contentTextarea = document.getElementById('content');
    const quill = new Quill('#editor', {
      theme: 'snow',
      placeholder: 'Compose the article content here...',
      modules: {
        toolbar: [
          [{ header: [1, 2, 3, false] }],
          ['bold', 'italic', 'underline', 'strike'],
          ['blockquote', 'code-block'],
          [{ list: 'ordered' }, { list: 'bullet' }],
          ['link', 'image'],
          [{ align: [] }],
          ['clean']
        ]
      }
    });

    const existingContent = contentTextarea.value.trim();
    if (existingContent) {
      const isHtml = /<[^>]+>/.test(existingContent);
      quill.root.innerHTML = isHtml ? existingContent : marked.parse(existingContent);
    }

    document.querySelector('form').addEventListener('submit', () => {
      contentTextarea.value = quill.root.innerHTML.trim();
    });
  </script>
</body>
</html>

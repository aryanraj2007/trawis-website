<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>

</head>
<body>

  <div class="admin-wrapper">
    <%- include('../partials/admin-sidebar', { currentUser: currentUser, activeSection: 'dashboard' }) %>

    <!-- MAIN CONTENT AREA -->
    <main class="admin-content">
      
      <!-- TOP CONTENT BAR -->
      <div class="content-header">
        <div>
          <h2 class="content-title">Blog Posts Manager</h2>
          <p class="text-muted mb-0" style="font-size: 0.88rem;">Create, edit, and publish resource articles for marketing promotion.</p>
        </div>
        
        <a href="/admin/posts/new" class="btn btn-brand" style="border-radius: 8px; font-weight: 700; font-size: 0.9rem; padding: 0.6rem 1.2rem;">
          <i class="bi bi-plus-lg me-1"></i> New Article
        </a>
      </div>
      
      <!-- MINI METRICS ROW -->
      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <div class="metric-card">
            <div class="metric-icon">
              <i class="bi bi-file-earmark-text"></i>
            </div>
            <div>
              <h4 class="metric-number"><%= posts.length %></h4>
              <span class="metric-label">Total Articles</span>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="metric-card">
            <div class="metric-icon icon-primary">
              <i class="bi bi-check2-circle"></i>
            </div>
            <div>
              <h4 class="metric-number"><%= posts.filter(p => p.status === 'published').length %></h4>
              <span class="metric-label">Published</span>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="metric-card">
            <div class="metric-icon" style="background: rgba(107, 101, 117, 0.08); color: var(--text-muted);">
              <i class="bi bi-pencil-square"></i>
            </div>
            <div>
              <h4 class="metric-number"><%= posts.filter(p => p.status === 'draft').length %></h4>
              <span class="metric-label">Drafts</span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- POSTS CARD LIST PANEL -->
      <div class="admin-card">
        <% if (posts.length === 0) { %>
          <div class="text-center py-5">
            <i class="bi bi-journal-x text-muted mb-3 d-block" style="font-size: 2.5rem;"></i>
            <h5 class="fw-bold">No articles created yet</h5>
            <p class="text-muted mb-4 fs-9">Write marketing insights to promote TraWis platform solutions.</p>
            <a href="/admin/posts/new" class="btn btn-brand btn-sm px-3">
              Write First Post
            </a>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-custom align-middle">
              <thead>
                <tr>
                  <th style="width: 70px;">Cover</th>
                  <th>Article Title</th>
                  <th>Author</th>
                  <th>Status</th>
                  <th>Published Date</th>
                  <th style="width: 100px;" class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% posts.forEach(post => { %>
                  <tr>
                    <td>
                      <% if (post.cover_image) { %>
                        <img src="<%= post.cover_image %>" alt="Cover" class="post-thumbnail">
                      <% } else { %>
                        <div class="no-image-placeholder">
                          <i class="bi bi-image" style="opacity: 0.6;"></i>
                        </div>
                      <% } %>
                    </td>
                    <td>
                      <div class="fw-bold text-dark" style="font-size: 0.95rem;"><%= post.title %></div>
                      <small class="text-muted d-block mt-0.5">
                        <% if (post.status === 'published') { %>
                          <a href="/resources/blog/<%= post.slug %>" target="_blank" class="text-secondary text-decoration-none">
                            <i class="bi bi-link-45deg"></i> /resources/blog/<%= post.slug %>
                          </a>
                        <% } else { %>
                          <span style="opacity: 0.5;">Slug: <%= post.slug %></span>
                        <% } %>
                      </small>
                    </td>
                    <td>
                      <span class="fw-semibold" style="font-size: 0.88rem;"><%= post.author_name || 'System' %></span>
                    </td>
                    <td>
                      <% if (post.status === 'published') { %>
                        <span class="badge-status badge-published">
                          <i class="bi bi-check-circle-fill"></i> Published
                        </span>
                      <% } else { %>
                        <span class="badge-status badge-draft">
                          <i class="bi bi-pencil-fill"></i> Draft
                        </span>
                      <% } %>
                    </td>
                    <td>
                      <small class="text-muted">
                        <%= post.published_at ? new Date(post.published_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '-' %>
                      </small>
                    </td>
                    <td class="text-end">
                      <div class="d-inline-flex gap-2">
                        <a href="/admin/posts/<%= post.id %>/edit" class="btn-action btn-action-edit" title="Edit Post">
                          <i class="bi bi-pencil-square"></i>
                        </a>
                        <form action="/admin/posts/<%= post.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this article?');" style="display:inline;">
                          <button type="submit" class="btn-action btn-action-delete" title="Delete Post">
                            <i class="bi bi-trash3-fill"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
      
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

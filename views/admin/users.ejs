<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>

  <div class="admin-wrapper">
    <%- include('../partials/admin-sidebar', { currentUser: currentUser, activeSection: 'users' }) %>

    <!-- MAIN CONTENT AREA -->
    <main class="admin-content">
      
      <!-- TOP CONTENT BAR -->
      <div class="content-header">
        <div>
          <h2 class="content-title">User Permissions Manager</h2>
          <p class="text-muted mb-0" style="font-size: 0.88rem;">Manage administrative accounts, specify roles, and assign workspace access privileges.</p>
        </div>
      </div>
      
      <!-- Alerts Area -->
      <% if (error) { %>
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 10px; font-size: 0.9rem;">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <span><%= error %></span>
        </div>
      <% } %>
      
      <% if (success) { %>
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 10px; font-size: 0.9rem;">
          <i class="bi bi-check-circle-fill"></i>
          <span><%= success %></span>
        </div>
      <% } %>

      <div class="row g-4">
        
        <!-- USERS TABLE LIST -->
        <div class="col-lg-7">
          <div class="admin-card h-100">
            <h5 class="fw-bold mb-4 font-heading" style="color: var(--text-dark);">Authorized Team Members</h5>
            
            <div class="table-responsive">
              <table class="table table-custom align-middle">
                <thead>
                  <tr>
                    <th>Username</th>
                    <th>System Role</th>
                    <th>Created</th>
                    <th style="width: 80px;" class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach(user => { %>
                    <tr>
                      <td>
                        <div class="fw-bold d-flex align-items-center gap-2" style="font-size: 0.92rem;">
                          <i class="bi bi-person-fill text-muted"></i>
                          <%= user.username %>
                          <% if (user.id === currentUser.id) { %>
                            <span class="badge bg-secondary fs-9" style="font-size: 0.65rem; padding: 0.2rem 0.4rem;">You</span>
                          <% } %>
                        </div>
                      </td>
                      <td>
                        <span class="role-badge role-<%= user.role %>">
                          <%= user.role === 'superadmin' ? 'Super Admin' : 'Editor' %>
                        </span>
                      </td>
                      <td>
                        <small class="text-muted">
                          <%= new Date(user.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                        </small>
                      </td>
                      <td class="text-end">
                        <% if (user.id !== currentUser.id) { %>
                          <form action="/admin/users/<%= user.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to revoke credentials for this user?');" style="display:inline;">
                            <button type="submit" class="btn-action-delete" title="Delete User">
                              <i class="bi bi-trash3-fill"></i>
                            </button>
                          </form>
                        <% } else { %>
                          <span class="text-muted" style="font-size: 0.78rem; opacity: 0.6;"><i class="bi bi-lock-fill"></i> Locked</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        
        <!-- REGISTER FORM -->
        <div class="col-lg-5">
          <div class="admin-card">
            <h5 class="fw-bold mb-4 font-heading" style="color: var(--text-dark);">Register New Administrator</h5>
            
            <form action="/admin/users" method="POST">
              <div class="mb-3">
                <label for="username" class="form-label-custom">Username</label>
                <input 
                  type="text" 
                  class="form-control form-control-custom w-100" 
                  id="username" 
                  name="username" 
                  placeholder="e.g. editor_sarah" 
                  required
                >
              </div>
              
              <div class="mb-3">
                <label for="password" class="form-label-custom">Initial Password</label>
                <input 
                  type="password" 
                  class="form-control form-control-custom w-100" 
                  id="password" 
                  name="password" 
                  placeholder="Enter a secure password" 
                  required
                >
              </div>
              
              <div class="mb-4">
                <label for="role" class="form-label-custom">Access Permission Role</label>
                <select class="form-select form-select-custom w-100" id="role" name="role" required>
                  <option value="editor" selected>Editor (Manage Blog Posts Only)</option>
                  <option value="superadmin">Super Admin (All permissions)</option>
                </select>
                <div class="form-text text-muted fs-9 mt-2">
                  <i class="bi-info-circle me-1"></i> Editors can create and publish articles, but are strictly blocked from adding/removing other administrator users.
                </div>
              </div>
              
              <button type="submit" class="btn btn-brand w-100 py-2 d-flex align-items-center justify-content-center gap-2" style="border-radius: 8px; font-weight: 700; font-size: 0.9rem;">
                <i class="bi bi-person-plus-fill"></i> Register Account
              </button>
            </form>
          </div>
        </div>

      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

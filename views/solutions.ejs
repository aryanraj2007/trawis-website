<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>

<body>
  <%- include('partials/header') %>

  <main>
    <!-- SOLUTIONS HERO -->
    <section class="section section-dark">
      <div class="hero-bg-glow"></div>

      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-6">

            <h1 class="hero-title animate-up delay-1">
              Purpose-Built for Every <span>Trading Function</span>
            </h1>

            <p class="hero-subtitle animate-up delay-2">
              TraWis delivers role-specific intelligence for traders, risk managers,
              schedulers, and pricers, bringing market signals, operational data,
              and AI-powered recommendations into one unified decision environment.
            </p>

            <div class="hero-actions animate-up delay-3">
              <a href="/demo" class="btn btn-brand btn-lg">Schedule a Demo</a>
              <a href="#workspaces" class="btn btn-ghost btn-lg">Explore Workspaces</a>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="product-architecture-card animate-up delay-2">
              <div class="architecture-row">
                <span>TraWis</span>
                <strong>Unified Intelligence Layer</strong>
              </div>
              <div class="architecture-row">
                <span>Trader</span>
                <strong>Opportunity and execution intelligence</strong>
              </div>
              <div class="architecture-row">
                <span>Risk</span>
                <strong>Exposure and hedge intelligence</strong>
              </div>
              <div class="architecture-row">
                <span>Scheduler</span>
                <strong>Logistics and supply intelligence</strong>
              </div>
              <div class="architecture-row">
                <span>Pricer</span>
                <strong>Deal and margin intelligence</strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- SHARED PLATFORM -->
    <section class="section section-soft" id="workspaces">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">One Platform. Multiple Decision Workspaces.</div>

          <h2 class="section-title">
            Intelligence Tailored to Every Trading Role
          </h2>

          <p class="section-text mx-auto">
            Every trading role faces a different challenge, but all depend on the same
            underlying intelligence. TraWis combines predictive pricing, operational
            visibility, risk monitoring, and explainable AI recommendations into a
            unified platform tailored to each function.
          </p>
        </div>

        <div class="row g-4">
          <div class="col-md-6">
            <article class="product-agent-card">
              <div class="product-agent-content-yellow">
                <!-- <span>Workspace 01</span> -->
                <h3>Trader Workspace</h3>
                <p>
                  A digital co-pilot for physical executions, derivative swaps,
                  spread forecasting, position monitoring, and strategy-aware
                  trade recommendations.
                </p>
              </div>
              <img src="/assets/dashboard.png" alt="Trader workspace">
            </article>
          </div>

          <div class="col-md-6">
            <article class="product-agent-card">
              <div class="product-agent-content-yellow">
                <!-- <span>Workspace 02</span> -->
                <h3>Risk Manager Workspace</h3>
                <p>
                  Continuous exposure shielding with anomaly detection, hedge recommendations,
                  policy enforcement, and real-time margin volatility monitoring.
                </p>
              </div>
              <img src="/assets/recs.png" alt="Risk manager workspace">
            </article>
          </div>

          <div class="col-md-6">
            <article class="product-agent-card">
              <div class="product-agent-content-yellow">
                <!-- <span>Workspace 03</span> -->
                <h3>Scheduler Workspace</h3>
                <p>
                  Connects commercial trade paper with physical logistics by analyzing
                  refinery output, terminal inventories, marine assets, weather, and freight.
                </p>
              </div>
              <img src="/assets/ai-platform.png" alt="Scheduler workspace">
            </article>
          </div>

          <div class="col-md-6">
            <article class="product-agent-card">
              <div class="product-agent-content-yellow">
                <!-- <span>Workspace 04</span> -->
                <h3>Pricer Workspace</h3>
                <p>
                  Localized deal-pricing simulations that evaluate regional constraints,
                  asset-level margin realities, physical differentials, and spread intelligence.
                </p>
              </div>
              <img src="/assets/pricing.png" alt="Pricer workspace">
            </article>
          </div>
        </div>
      </div>
    </section>


    <!-- TRADER WORKSPACE -->
    <section class="section">
      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-6">
            <div class="section-kicker">Trader Workspace</div>

            <h2 class="section-title">
              Turn Market Signals Into Trading Opportunities
            </h2>

            <p class="section-text">
              An AI-powered co-pilot that helps traders identify opportunities,
              evaluate risk, and execute with confidence.
            </p>

            <div class="row g-3 mt-2">
              <div class="col-sm-6">
                <article class="feature-card">
                  <h3>Core Capabilities</h3>
                  <p>
                    Predictive commodity pricing, spread forecasting, position monitoring,
                    buy, sell, and hedge recommendations, confidence scoring, and
                    one-click governed approvals.
                  </p>
                </article>
              </div>

              <div class="col-sm-6">
                <article class="feature-card">
                  <h3>Business Impact</h3>
                  <p>
                    Faster trade decisions, reduced spreadsheet dependency,
                    and improved margin capture.
                  </p>
                </article>
              </div>
            </div>

            <p class="section-text">
              <strong>Protect institutional knowledge by embedding proven trading strategies into governed decision workflows.</strong>
            </p>
          </div>

          <div class="col-lg-6">
            <div class="browser-card">
              <div class="browser-dots">
                <span></span><span></span><span></span>
              </div>
              <img src="/assets/dashboard.png" alt="Trader dashboard with market highlights, price forecasts, recommendations, and confidence scores" class="product-demo-img">
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- RISK WORKSPACE -->
    <section class="section section-dark">
      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-6 order-lg-2">
            <div class="section-kicker">Risk Manager Workspace</div>

            <h2 class="section-title text-white">
              Monitor Exposure Before It Becomes Risk
            </h2>

            <p class="section-text text-white-70">
              Continuously monitor portfolio exposure and receive proactive
              recommendations before small issues become major losses.
            </p>

            <ul class="check-list">
              <li>Real-time risk monitoring</li>
              <li>Margin exposure alerts</li>
              <li>Hedge recommendations</li>
              <li>VaR monitoring</li>
              <li>Policy enforcement and compliance controls</li>
            </ul>

            <p class="section-text text-white-70">
              <strong>Move from reactive reporting to continuous risk intelligence.</strong>
            </p>
          </div>

          <div class="col-lg-6 order-lg-1">
            <div class="browser-card">
              <div class="browser-dots">
                <span></span><span></span><span></span>
              </div>
              <img src="/assets/recs.png" alt="Risk dashboard with exposure heatmap, alerts, hedge recommendations, and policy exceptions" class="product-demo-img">
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- SCHEDULER WORKSPACE -->
    <section class="section section-soft">
      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-6">
            <div class="section-kicker">Scheduler Workspace</div>

            <h2 class="section-title">
              Connect Commercial Decisions With Physical Operations
            </h2>

            <p class="section-text">
              Optimize logistics, inventory, transportation, and delivery execution
              using real-time operational intelligence.
            </p>

            <div class="row g-3 mt-2">
              <div class="col-sm-6">
                <article class="feature-card">
                  <h3>Core Capabilities</h3>
                  <p>
                    Logistics visibility, weather monitoring, supply chain alerts,
                    inventory optimization, route recommendations, and demurrage risk reduction.
                  </p>
                </article>
              </div>

              <div class="col-sm-6">
                <article class="feature-card">
                  <h3>Business Impact</h3>
                  <p>
                    Reduced operational disruption, improved asset utilization,
                    and lower logistics costs.
                  </p>
                </article>
              </div>
            </div>

            <p class="section-text">
              <strong>Turn logistics constraints into strategic decision inputs.</strong>
            </p>
          </div>

          <div class="col-lg-6">
            <div class="browser-card">
              <div class="browser-dots">
                <span></span><span></span><span></span>
              </div>
              <img src="/assets/ai-platform.png" alt="Scheduler interface with terminals, routes, inventory, and weather data" class="product-demo-img">
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- PRICER WORKSPACE -->
    <section class="section">
      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-6 order-lg-2">
            <div class="section-kicker">Pricer Workspace</div>

            <h2 class="section-title">
              Optimize Every Deal for Maximum Margin
            </h2>

            <p class="section-text">
              Simulate pricing scenarios using market conditions, regional dynamics,
              and operational realities.
            </p>

            <div class="row g-3 mt-2">
              <div class="col-sm-6">
                <article class="feature-card">
                  <h3>Core Capabilities</h3>
                  <p>
                    Localized pricing models, spread optimization, arbitrage analysis,
                    margin simulations, scenario modeling, and contract pricing intelligence.
                  </p>
                </article>
              </div>

              <div class="col-sm-6">
                <article class="feature-card">
                  <h3>Business Impact</h3>
                  <p>
                    Improved pricing precision, increased profitability,
                    and faster quote generation.
                  </p>
                </article>
              </div>
            </div>

            <p class="section-text">
              <strong>Move beyond static indices to dynamic, context-aware pricing intelligence.</strong>
            </p>
          </div>

          <div class="col-lg-6 order-lg-1">
            <div class="browser-card">
              <div class="browser-dots">
                <span></span><span></span><span></span>
              </div>
              <img src="/assets/pricing.png" alt="Pricing simulation dashboard with regional margin and spread analysis" class="product-demo-img">
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- CROSS-FUNCTIONAL VALUE -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Cross-Functional Value</div>

          <h2 class="section-title text-white">
            Better Decisions Start With Shared Intelligence
          </h2>

          <p class="section-text text-white-70 mx-auto">
            While each workspace is tailored to a specific function, all decisions
            are powered by the same underlying intelligence layer, ensuring every
            team works from a single version of the truth.
          </p>
        </div>

        <div class="product-architecture-card">
          <div class="architecture-row">
            <span>Shared Inputs</span>
            <strong>Market Data • Weather • Geopolitical Signals • Enterprise Systems</strong>
          </div>

          <div class="architecture-row">
            <span>TraWis</span>
            <strong>Unified Data • Prediction • Reasoning • Recommendations</strong>
          </div>

          <div class="architecture-row">
            <span>Decision Workspaces</span>
            <strong>Trader • Risk • Scheduler • Pricer</strong>
          </div>
        </div>
      </div>
    </section>


    <!-- BUSINESS RESULTS -->
    <section class="section section-soft">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Business Results</div>

          <h2 class="section-title">
            Built to Improve Outcomes Across the Trading Organization
          </h2>
        </div>

        <div class="impact-grid">
          <div class="impact-card">
            <strong>40–50</strong>
            <span>%</span>
            <p>Faster decisions</p>
          </div>

          <div class="impact-card">
            <strong>2–4</strong>
            <span>%</span>
            <p>Margin improvement</p>
          </div>

          <div class="impact-card">
            <strong>20–25</strong>
            <span>%</span>
            <p>Risk reduction</p>
          </div>

          <div class="impact-card">
            <strong>Up to 25</strong>
            <span>%</span>
            <p>Less manual effort</p>
          </div>
        </div>
      </div>
    </section>


    <!-- CTA -->
    <section class="section demo-cta">
      <div class="container">
        <div class="cta-card">
          <div>
            <div class="section-kicker">Every Trading Function. One Intelligence Layer.</div>

            <h2>Every Trading Function. One Intelligence Layer.</h2>

            <p>
              See how TraWis helps trading teams move from fragmented information
              to coordinated, intelligent action.
            </p>
            <br><a href="/demo" class="btn btn-brand btn-lg">Schedule a Demo</a>
          </div>

        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>

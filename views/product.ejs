<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>

<body>
  <%- include('partials/header') %>

  <main>
    <!-- PRODUCT HERO -->
    <section class="section section-dark product-hero">
      <div class="hero-bg-glow"></div>

      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-6">

            <h1 class="hero-title animate-up delay-1">
              One Intelligent Decision Layer Above Your <span>Existing Systems</span>
            </h1>

            <p class="hero-subtitle animate-up delay-2">
              TraWis brings predictive signals, confidence scores, risk alerts,
              recommendations, and audit-ready decision trails, all in one place.
            </p>

            <div class="hero-actions animate-up delay-3">
              <a href="/demo" class="btn btn-brand btn-lg">Schedule a Demo</a>
              <a href="#product-stack" class="btn btn-ghost btn-lg">See How It Works</a>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="product-visual-wrap animate-up delay-2">
              <div class="browser-card hero-demo-card">
                <div class="browser-dots">
                  <span></span><span></span><span></span>
                </div>

                <img
                  src="/assets/dashboard.png"
                  alt="TraWis unified decision workspace"
                  class="img-fluid product-demo-img"
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- OVERVIEW -->
    <section class="section section-soft">
      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-5">
            <div class="section-kicker">Product Overview</div>

            <h2 class="section-title">
              Extend the Value of Your Existing Technology Landscape
            </h2>
          </div>

          <div class="col-lg-7">
            <p class="section-text">
              TraWis sits above existing ETRM, CTRM, ERP, logistics, contract,
              and operational systems. It brings market and enterprise intelligence
              together without replacing the systems that execute and record transactions.
            </p>

            <p class="section-text">
              The result is a unified decision environment that helps trading teams
              predict, recommend, monitor, and execute with greater speed,
              explainability, and control.
            </p>
          </div>
        </div>
      </div>
    </section>


    <!-- THREE LAYERS -->
    <section class="section" id="product-stack">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">How It Works</div>

          <h2 class="section-title">
            The Three Layers of TraWis
          </h2>

          <p class="section-text mx-auto">
            A connected technology stack that transforms raw signals into trusted,
            explainable, and governed decisions.
          </p>
        </div>

        <div class="row g-4">
          <div class="col-lg-4">
            <article class="feature-card product-layer-card">
              <div class="product-layer-image">
                <img src="/assets/price-insight-engine.png" alt="Pricing Insight Engine">
              </div>

              <div class="feature-icon">1</div>
              <h3>Pricing Insight Engine</h3>

              <p>
                Uses machine learning models to interpret sequential market patterns,
                volatility, sentiment, and long-range micro-signals.
              </p>

              <ul class="product-mini-list">
                <li>Historical market data</li>
                <li>Weather and geopolitical signals</li>
                <li>Operational and market context</li>
              </ul>
              <br>
              <p><strong>Forecasts commodity prices using market, weather, geopolitical, and operational signals.</strong></p>
            </article>
          </div>

          <div class="col-lg-4">
            <article class="feature-card product-layer-card">
              <div class="product-layer-image">
                <img src="/assets/data-core.png" alt="Data Core Platform">
              </div>

              <div class="feature-icon">2</div>
              <h3>Data Core Platform</h3>

              <p>
                Connects and normalizes data from enterprise systems, operations,
                logistics, contracts, and external market sources.
              </p>

              <ul class="product-mini-list">
                <li>8+ native enterprise connectors</li>
                <li>Automated schema labeling</li>
                <li>Structured data optimized for AI</li>
              </ul>
              <br>
              <p><strong>Unifies internal and external data into a single trusted source for decision-making.</strong></p>
            </article>
          </div>

          <div class="col-lg-4">
            <article class="feature-card product-layer-card">
              <div class="product-layer-image">
                <img src="/assets/agentic-rec-layer.png" alt="Agentic AI Recommendation Layer">
              </div>

              <div class="feature-icon">3</div>
              <h3>Agentic AI Recommendation Layer</h3>

              <p>
                Evaluates real-time variables against risk profiles, policy guardrails,
                and operational constraints.
              </p>

              <ul class="product-mini-list">
                <li>Role-specific recommendations</li>
                <li>Explainable decision reasoning</li>
                <li>Governed execution workflows</li>
              </ul>
              <br><br>
              <p><strong>Generates explainable recommendations and governed workflows tailored to trading operations.</strong></p>
            </article>
          </div>
        </div>
      </div>
    </section>


<!-- PRODUCT CAPABILITIES -->
<section class="section section-soft">
  <div class="container">
    <div class="section-heading text-center">
      <div class="section-kicker">Product Capabilities</div>

      <h2 class="section-title">
        From Insight to Action
      </h2>

      <p class="section-text mx-auto">
        TraWis helps trading teams move from market signals to confident,
        governed execution.
      </p>
    </div>

    <div class="row g-4">
      <div class="col-md-6 col-lg-3">
        <article
          class="capability-visual-card"
          style="background-image: url('/assets/predict.jpeg');"
        >
          <div class="capability-card-overlay"></div>

          <div class="capability-card-content">
            <div class="feature-icon">1</div>
            <h3>Predict</h3>
            <p>Forecast pricing, spreads, and market movements.</p>
          </div>
        </article>
      </div>

      <div class="col-md-6 col-lg-3">
        <article
          class="capability-visual-card"
          style="background-image: url('/assets/recommend.jpeg');"
        >
          <div class="capability-card-overlay"></div>

          <div class="capability-card-content">
            <div class="feature-icon">2</div>
            <h3>Recommend</h3>
            <p>Generate buy, sell, hedge, and risk actions.</p>
          </div>
        </article>
      </div>

      <div class="col-md-6 col-lg-3">
        <article
          class="capability-visual-card"
          style="background-image: url('/assets/monitor.jpeg');"
        >
          <div class="capability-card-overlay"></div>

          <div class="capability-card-content">
            <div class="feature-icon">3</div>
            <h3>Monitor</h3>
            <p>Track positions, exposure, and constraints in real time.</p>
          </div>
        </article>
      </div>

      <div class="col-md-6 col-lg-3">
        <article
          class="capability-visual-card"
          style="background-image: url('/assets/execute.jpeg');"
        >
          <div class="capability-card-overlay"></div>

          <div class="capability-card-content">
            <div class="feature-icon">4</div>
            <h3>Execute</h3>
            <p>Initiate governed workflows back into enterprise systems.</p>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

    <!-- PRODUCT EXPERIENCE -->
    <section class="section section-dark product-section">
      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-5">
            <div class="section-kicker">Product Experience</div>

            <h2 class="section-title text-white">
              Built for the Modern Trading Desk
            </h2>

            <p class="section-text text-white-70">
              Predictive signals, recommended actions, confidence scores, risk alerts,
              and audit-ready decision trails unified in a single AI-powered
              intelligence workbench.
            </p>

            <ul class="check-list">
              <li>Predictive pricing</li>
              <li>Buy, sell, and hedge recommendations</li>
              <li>Explainable AI reasoning</li>
              <li>Audit-ready decision trails</li>
              <li>Real-time aggregation of trading-critical data</li>
            </ul>
          </div>

          <div class="col-lg-7">
            <div class="demo-gallery">
              <div class="browser-card demo-card-large">
                <div class="browser-dots">
                  <span></span><span></span><span></span>
                </div>

                <img
                  src="/assets/dashboard.png"
                  alt="TraWis modern trading desk"
                  class="img-fluid product-demo-img"
                >
              </div>

                 <div class="demo-stack">
      <div class="demo-stack-item">
        <img
          src="/assets/screen-chart.png"
          alt="Predictive pricing interface"
        >
      </div>

      <div class="demo-stack-item">
        <img
          src="/assets/screen-op.png"
          alt="Unified intelligence platform"
        >
      </div>

      <div class="demo-stack-item">
        <img
          src="/assets/screen-rec.png"
          alt="AI recommendations interface"
        >
      </div>
    </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- INTEGRATIONS -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Integrations</div>

          <h2 class="section-title">
            Works With Your Existing Technology Landscape
          </h2>

          <p class="section-text mx-auto">
            TraWis sits above your existing ETRM, CTRM, ERP, and operational
            systems, extending their value rather than replacing them.
          </p>
        </div>

        <div class="row g-3 justify-content-center text-center">
          <% ['SAP CTRM', 'Endur', 'RightAngle', 'ERP', 'AWS', 'Data Feeds'].forEach(item => { %>
            <div class="col-6 col-md-4 col-lg-2">
              <div class="feature-card h-100 d-flex align-items-center justify-content-center">
                <h3 class="mb-0"><%= item %></h3>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>


    <!-- SOLUTIONS LINK -->
    <!-- <section class="section section-soft">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Solutions</div>

          <h2 class="section-title">
            Purpose-Built Workspaces for Every Trading Function
          </h2>

          <p class="section-text mx-auto">
            Explore role-specific intelligence for traders, risk managers,
            schedulers, and pricers.
          </p>
        </div>

        <div class="hero-actions justify-content-center">
          <a href="/solutions" class="btn btn-brand btn-lg">Explore Solutions</a>
        </div>
      </div>
    </section> -->


    <!-- ENTERPRISE ARCHITECTURE -->
    <section class="section section-soft">
      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-5">
            <div class="section-kicker">Enterprise Architecture</div>

            <h2 class="section-title">
              Designed for Secure, High-Compute Enterprise Environments
            </h2>

            <p class="section-text">
              TraWis combines real-time data ingestion, AI model orchestration,
              enterprise integration, and governed execution in a secure
              cloud-native architecture.
            </p>
          </div>

          <div class="col-lg-7">
            <div class="product-architecture-card">
              <div class="architecture-row">
                <span>External Signals</span>
                <strong>Market • Weather • Geopolitical</strong>
              </div>

              <div class="architecture-row">
                <span>Enterprise Systems</span>
                <strong>ETRM • CTRM • ERP</strong>
              </div>

              <div class="architecture-row">
                <span>TraWis Data Core</span>
                <strong>Normalized, labeled, trusted enterprise data</strong>
              </div>

              <div class="architecture-row">
                <span>AI Decision Engine</span>
                <strong>Prediction • Reasoning • Recommendations</strong>
              </div>

              <div class="architecture-row">
                <span>Decision Workspaces</span>
                <strong>Trader • Risk • Scheduler • Pricer</strong>
              </div>

              <div class="architecture-row">
                <span>Governed Execution</span>
                <strong>Approvals • Audit trails • Enterprise workflows</strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


   <!-- SECURITY -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Security & governance</div>

          <h2 class="section-title">
            Built with enterprise controls from the start.
          </h2>

          <p class="section-text mx-auto">
            TraWis is designed for high-trust trading environments where operational data,
            strategy, policy, and auditability matter.
          </p>
        </div>

        <div class="row g-4">
          <div class="col-md-6 col-lg-3">
            <article class="feature-card">
              <div class="feature-icon">1</div>
              <h3>Network isolation</h3>
              <p>
                Designed for isolated network environments, private connectivity,
                and secure system integration.
              </p>
            </article>
          </div>

          <div class="col-md-6 col-lg-3">
            <article class="feature-card">
              <div class="feature-icon">2</div>
              <h3>Encryption</h3>
              <p>
                Supports encryption at rest and in transit across data, artifacts,
                and sensitive operational strings.
              </p>
            </article>
          </div>

          <div class="col-md-6 col-lg-3">
            <article class="feature-card">
              <div class="feature-icon">3</div>
              <h3>Audit trails</h3>
              <p>
                Captures decision activity and execution context for internal
                governance and external review.
              </p>
            </article>
          </div>

          <div class="col-md-6 col-lg-3">
            <article class="feature-card">
              <div class="feature-icon">4</div>
              <h3>Strategy protection</h3>
              <p>
                Supports localized scenario modeling without exposing proprietary
                trading strategies unnecessarily.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

        <!-- SECURITY & GOVERNANCE -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Security &amp; Governance</div>

          <h2 class="section-title text-white">
            Enterprise-Grade Security. Built-in Governance.
          </h2>

          <p class="section-text text-white-70 mx-auto">
            TraWis is engineered to meet the security, regulatory, compliance,
            and operational requirements of global tier-1 energy and financial institutions.
          </p>
        </div>

        <div class="row g-4">
          <div class="col-lg-4">
            <article class="product-agent-card">
              <div class="product-agent-content">
                <span>Secure by Design</span>
                <h3>Protected Infrastructure</h3>
                <p>
                  Secure cloud-native isolated network architecture, private subnets,
                  secure API access, perimeter protection, and continuous monitoring.
                </p>
              </div>
            </article>
          </div>

          <div class="col-lg-4">
            <article class="product-agent-card">
              <div class="product-agent-content">
                <span>End-to-End Protection</span>
                <h3>Protected Data</h3>
                <p>
                  Encryption at rest and in transit, secure key management, protection
                  of sensitive operational and PII data, and tamper-resistant audit trails.
                </p>
              </div>
            </article>
          </div>

          <div class="col-lg-4">
            <article class="product-agent-card">
              <div class="product-agent-content">
                <span>Audit &amp; Governance</span>
                <h3>Explainable and Controlled</h3>
                <p>
                  Complete decision traceability, policy-driven approvals,
                  compliance-ready reporting, and governed execution.
                </p>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- IP PROTECTION -->
    <section class="section section-soft">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Protected Intellectual Property</div>

          <h2 class="section-title">
            Your Competitive Advantage Stays Yours
          </h2>

          <p class="section-text mx-auto">
            TraWis helps organizations operationalize intelligence without exposing
            proprietary trading strategies or institutional knowledge.
          </p>
        </div>

        <div class="row g-4">
          <div class="col-lg-6">
            <article class="feature-card">
              <div class="feature-icon">1</div>
              <h3>Pricing Engine Matrix™</h3>
              <p>
                Patent-pending multi-model AI weighting that combines historical market
                data, weather intelligence, and geopolitical sentiment to generate
                explainable confidence scores and predictive insights.
              </p>
            </article>
          </div>

          <div class="col-lg-6">
            <article class="feature-card">
              <div class="feature-icon">2</div>
              <h3>Functional Reasoner Models™</h3>
              <p>
                Specialized decision-logic architecture that enables scenario simulation
                and recommendation generation while preserving trader-specific strategies
                and business rules.
              </p>
            </article>
          </div>
        </div>

        <div class="pricing-card mt-4">
          <div class="pricing-row">
            <span>Enterprise Security</span>
            <strong>End-to-End Encryption</strong>
          </div>
          <div class="pricing-row">
            <span>Audit Trails</span>
            <strong>Governance Controls</strong>
          </div>
          <div class="pricing-row">
            <span>Patent-Pending Innovation</span>
            <strong>Protected Institutional Knowledge</strong>
          </div>
        </div>
      </div>
    </section>


    <!-- BUSINESS IMPACT -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Business Impact</div>

          <h2 class="section-title">
            Faster Decisions. Stronger Margins. Lower Risk.
          </h2>

          <p class="section-text mx-auto">
            TraWis helps trading organizations move from fragmented information
            to intelligent action.
          </p>
        </div>

        <div class="impact-grid">
          <div class="impact-card">
            <strong>2–4</strong>
            <span>%</span>
            <p>Potential margin improvement</p>
          </div>

          <div class="impact-card">
            <strong>20–25</strong>
            <span>%</span>
            <p>Potential risk reduction</p>
          </div>

          <div class="impact-card">
            <strong>40–50</strong>
            <span>%</span>
            <p>Faster decisions</p>
          </div>

          <div class="impact-card">
            <strong>25</strong>
            <span>%</span>
            <p>Less manual effort</p>
          </div>
        </div>

        <div class="section-heading text-center mt-5">
          <h3>Platform Performance</h3>
        </div>

        <div class="impact-grid">
          <div class="impact-card">
            <strong>&lt;500</strong>
            <span>ms</span>
            <p>Target response latency</p>
          </div>

          <div class="impact-card">
            <strong>8</strong>
            <span>+</span>
            <p>Native enterprise connectors</p>
          </div>

          <div class="impact-card">
            <strong>99.9</strong>
            <span>%</span>
            <p>Platform availability target</p>
          </div>

          <div class="impact-card">
            <strong>24/7</strong>
            <p>Enterprise security and governance</p>
          </div>
        </div>
      </div>
    </section>


    <!-- CTA -->
    <section class="section demo-cta">
      <div class="container">
        <div class="cta-card">
          <div>
            <div class="section-kicker">See TraWis in Action</div>

            <h2>See TraWis in Action</h2>

            <p>
              Discover how energy trading teams are transforming fragmented data
              into intelligent trading decisions.
            </p>
          </div>

          <a href="/demo" class="btn btn-brand btn-lg">Schedule a Demo</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>

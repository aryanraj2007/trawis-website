<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>

<body>
  <%- include('partials/header') %>

  <main>
    <!-- PRODUCT HERO -->
    <section class="section section-dark product-hero">
      <div class="hero-bg-glow"></div>

      <div class="container ">
        <div class="row align-items-center gy-5">
          <div class="col-lg-6">

            <h1 class="hero-title animate-up delay-1">
              AI-powered trade intelligence for the <span>modern energy desk</span>
            </h1>

            <p class="hero-subtitle animate-up delay-2">
              TraWis combines predictive pricing, normalized enterprise data, and
              role-based AI agents to help trading teams move from fragmented analysis
              to confident action.
            </p>

            <div class="hero-actions animate-up delay-3">
              <a href="/demo" class="btn btn-brand btn-lg">Schedule Demo</a>
              <a href="#product-stack" class="btn btn-ghost btn-lg">Explore Platform</a>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="product-visual-wrap animate-up delay-2">
              <div class="browser-card hero-demo-card">
                <div class="browser-dots">
                  <span></span><span></span><span></span>
                </div>

                <img
                  src="/assets/dashboard.png"
                  alt="TraWis product dashboard"
                  class="img-fluid product-demo-img"
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- PRODUCT OVERVIEW -->
    <section class="section section-soft">
      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-5">
            <div class="section-kicker">Product overview</div>

            <h2 class="section-title">
              One workspace above your trading systems.
            </h2>
          </div>

          <div class="col-lg-7">
            <p class="section-text">
              TraWis is designed as an intelligence layer above existing ETRM, CTRM,
              ERP, logistics, contract, and market data environments. It does not
              replace core systems. It helps teams analyze, recommend, govern, and
              initiate better decisions before execution flows back into enterprise platforms.
            </p>

            <p class="section-text">
              The platform brings together high-performance machine learning, secure data
              normalization, and specialized AI agents for traders, risk managers,
              schedulers, and pricers.
            </p>
          </div>
        </div>
      </div>
    </section>


    <!-- 3 LAYER STACK -->
    <section class="section" id="product-stack">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Core platform</div>

          <h2 class="section-title">
            The 3-layer TraWis technology stack.
          </h2>

          <p class="section-text mx-auto">
            From market prediction to clean enterprise data to agentic recommendations,
            TraWis is built to support enterprise-grade trading decisions.
          </p>
        </div>

        <div class="row g-4">
          <!-- Layer 1 -->
          <div class="col-lg-4">
            <article class="feature-card product-layer-card">
              <div class="product-layer-image">
                <img
                  src="https://placehold.co/720x460/2b2331/ffc400?text=Pricing+Insight+Engine"
                  alt="Pricing Insight Engine"
                >
              </div>

              <div class="feature-icon">1</div>

              <h3>Pricing Insight Engine</h3>

              <p>
                A multi-model ML framework that uses Transformers, NLP, and Graph Neural
                Networks to recognize price patterns, long-range signals, volatility,
                sentiment, and confidence.
              </p>

              <ul class="product-mini-list">
                <li>7 years of historical market data</li>
                <li>Weather and geopolitical signals</li>
                <li>Crude price forecasting with confidence scoring</li>
              </ul>
            </article>
          </div>

          <!-- Layer 2 -->
          <div class="col-lg-4">
            <article class="feature-card product-layer-card">
              <div class="product-layer-image">
                <img
                  src="https://placehold.co/720x460/4d2f63/ffffff?text=Data+Core+Platform"
                  alt="Data Core Platform"
                >
              </div>

              <div class="feature-icon">2</div>

              <h3>Data Core Platform</h3>

              <p>
                A secure data amalgamation and normalization layer that bridges disconnected
                internal enterprise systems and external market data into a single version of truth.
              </p>

              <ul class="product-mini-list">
                <li>8 native API connectors</li>
                <li>Automated schema labeling</li>
                <li>Standardized data strings for ML models</li>
              </ul>
            </article>
          </div>

          <!-- Layer 3 -->
          <div class="col-lg-4">
            <article class="feature-card product-layer-card">
              <div class="product-layer-image">
                <img
                  src="https://placehold.co/720x460/b643f2/ffffff?text=Agentic+AI+Layer"
                  alt="Agentic AI Recommendation Layer"
                >
              </div>

              <div class="feature-icon">3</div>

              <h3>Agentic AI Recommendation Layer</h3>

              <p>
                Role-based AI agents evaluate trading desk functions against embedded
                risk profiles, operating policies, and real-time market variables.
              </p>

              <ul class="product-mini-list">
                <li>Trade, price, hedge, and risk recommendations</li>
                <li>Policy-aware decision support</li>
                <li>Workflow-based approval readiness</li>
              </ul>
            </article>
          </div>
        </div>
      </div>
    </section>


    <!-- PERSONA WORKSPACES -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Persona-based AI</div>

          <h2 class="section-title text-white">
            Purpose-built workspaces for every trade desk role.
          </h2>

          <p class="section-text text-white-70 mx-auto">
            Each agent is designed around the decisions, constraints, and outcomes
            of a specific trading function.
          </p>
        </div>

        <div class="row g-4">
          <!-- Trader Agent -->
          <div class="col-md-6">
            <article class="product-agent-card">
              <div class="product-agent-content">
                <span>Agent 01</span>
                <h3>Trader Agent Workspace</h3>
                <p>
                  A digital co-pilot for physical executions, derivative swaps,
                  spread forecasting, position monitoring, and strategy-aware trade recommendations.
                </p>
              </div>

              <img
                src="https://placehold.co/640x420/191620/ffc400?text=Trader+Workspace"
                alt="Trader Agent Workspace"
              >
            </article>
          </div>

          <!-- Risk Agent -->
          <div class="col-md-6">
            <article class="product-agent-card">
              <div class="product-agent-content">
                <span>Agent 02</span>
                <h3>Risk Manager Agent Workspace</h3>
                <p>
                  Continuous exposure shielding with anomaly detection, hedge recommendations,
                  policy enforcement, and real-time margin volatility monitoring.
                </p>
              </div>

              <img
                src="https://placehold.co/640x420/2b2331/ffffff?text=Risk+Workspace"
                alt="Risk Manager Agent Workspace"
              >
            </article>
          </div>

          <!-- Scheduler Agent -->
          <div class="col-md-6">
            <article class="product-agent-card">
              <div class="product-agent-content">
                <span>Agent 03</span>
                <h3>Scheduler Agent Workspace</h3>
                <p>
                  Connects commercial trade paper with physical logistics by analyzing
                  refinery output, terminal inventories, marine assets, weather, and freight.
                </p>
              </div>

              <img
                src="https://placehold.co/640x420/4d2f63/ffc400?text=Scheduler+Workspace"
                alt="Scheduler Agent Workspace"
              >
            </article>
          </div>

          <!-- Pricer Agent -->
          <div class="col-md-6">
            <article class="product-agent-card">
              <div class="product-agent-content">
                <span>Agent 04</span>
                <h3>Pricer Agent Workspace</h3>
                <p>
                  Localized deal-pricing simulations that evaluate regional constraints,
                  asset-level margin realities, physical differentials, and spread intelligence.
                </p>
              </div>

              <img
                src="https://placehold.co/640x420/552d72/ffffff?text=Pricer+Workspace"
                alt="Pricer Agent Workspace"
              >
            </article>
          </div>
        </div>
      </div>
    </section>


    <!-- ARCHITECTURE -->
    <section class="section section-soft">
      <div class="container">
        <div class="row align-items-center gy-5">
          <div class="col-lg-6">
            <div class="section-kicker">Architecture</div>

            <h2 class="section-title">
              Designed for secure, high-compute enterprise environments.
            </h2>

            <p class="section-text">
              TraWis is engineered for real-time data ingestion, distributed model compute,
              enterprise integration, encrypted storage, streaming data, and governed execution.
            </p>

            <p class="section-text">
              The platform supports high-volume requests across microservices, model inference,
              streaming market data, enterprise connectors, and audit-ready data trails.
            </p>

            <div class="hero-actions">
              <a href="/platform" class="btn btn-brand btn-lg">Explore Platform</a>
              <a href="/security" class="btn btn-outline-dark btn-lg">Security Overview</a>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="product-architecture-card">
              <div class="architecture-row">
                <span>Data Ingestion</span>
                <strong>Market, weather, logistics, enterprise data</strong>
              </div>

              <div class="architecture-row">
                <span>Enterprise Systems</span>
                <strong>ETRM, CTRM, ERP, contracts, refinery, marine</strong>
              </div>

              <div class="architecture-row">
                <span>Model Compute</span>
                <strong>LSTM, Transformer, CrudeBERT, GNN</strong>
              </div>

              <div class="architecture-row">
                <span>Decision Layer</span>
                <strong>Trader, risk, scheduler, and pricer agents</strong>
              </div>

              <div class="architecture-row">
                <span>Governance</span>
                <strong>Policy guardrails, approvals, audit trails</strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- SECURITY -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Security & governance</div>

          <h2 class="section-title">
            Built with enterprise controls from the start.
          </h2>

          <p class="section-text mx-auto">
            TraWis is designed for high-trust trading environments where operational data,
            strategy, policy, and auditability matter.
          </p>
        </div>

        <div class="row g-4">
          <div class="col-md-6 col-lg-3">
            <article class="feature-card">
              <div class="feature-icon">1</div>
              <h3>Network isolation</h3>
              <p>
                Designed for isolated network environments, private connectivity,
                and secure system integration.
              </p>
            </article>
          </div>

          <div class="col-md-6 col-lg-3">
            <article class="feature-card">
              <div class="feature-icon">2</div>
              <h3>Encryption</h3>
              <p>
                Supports encryption at rest and in transit across data, artifacts,
                and sensitive operational strings.
              </p>
            </article>
          </div>

          <div class="col-md-6 col-lg-3">
            <article class="feature-card">
              <div class="feature-icon">3</div>
              <h3>Audit trails</h3>
              <p>
                Captures decision activity and execution context for internal
                governance and external review.
              </p>
            </article>
          </div>

          <div class="col-md-6 col-lg-3">
            <article class="feature-card">
              <div class="feature-icon">4</div>
              <h3>Strategy protection</h3>
              <p>
                Supports localized scenario modeling without exposing proprietary
                trading strategies unnecessarily.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>


    <!-- IMPACT -->
    <section class="section section-soft">
      <div class="container">
        <div class="section-heading text-center">
          <div class="section-kicker">Product impact</div>

          <h2 class="section-title">
            Built to improve speed, margin, and control.
          </h2>
        </div>

        <div class="impact-grid">
          <div class="impact-card">
            <strong>2–4</strong>
            <span>%</span>
            <p>Potential operator trade margin extension</p>
          </div>

          <div class="impact-card">
            <strong>20–25</strong>
            <span>%</span>
            <p>Potential enterprise margin risk exposure reduction</p>
          </div>

          <div class="impact-card">
            <strong>&lt;500</strong>
            <span>ms</span>
            <p>Target performance latency at P95</p>
          </div>

          <div class="impact-card">
            <strong>8</strong>
            <span>+</span>
            <p>Native API connectors for enterprise systems</p>
          </div>
        </div>
      </div>
    </section>


    <!-- CTA -->
    <section class="section demo-cta">
      <div class="container">
        <div class="cta-card">
          <div>
            <div class="section-kicker">See the product</div>

            <h2>Explore how TraWis works across your trade desk.</h2>

            <p>
              Schedule a demo to walk through predictive pricing, normalized data,
              role-based agents, risk alerts, workflow governance, and enterprise integration.
            </p>
            <br><a href="/demo" class="btn btn-brand btn-lg">
            Schedule Demo
          </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
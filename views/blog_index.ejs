<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <!-- blog styles moved to /css/admin-blog.css -->
</head>
<body>

  <%- include('partials/header') %>

<!-- BLOG HERO -->
<section class="section section-dark blog-hero">
  <div class="hero-bg-glow"></div>

  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7">

        <h1 class="hero-title animate-up delay-1">
          Insights For The Next Era Of <span>Energy Trading</span>.
        </h1>

        <p class="hero-subtitle animate-up delay-2">
          Explore predictive pricing perspectives, trade workflow guides,
          AI-enabled decision support, and oil &amp; gas intelligence updates
          from the TraWis team.
        </p>

        <div class="hero-actions animate-up delay-3">
          <a href="/demo" class="btn btn-brand btn-lg">
            Schedule Demo
          </a>

        </div>
      </div>

      <div class="col-lg-5">
        <div class="blog-hero-card animate-up delay-2 mt-4 mt-lg-0">
          <div class="blog-hero-card-label">Featured themes</div>

          <div class="blog-topic-list">
            <span>Predictive pricing</span>
            <span>Risk intelligence</span>
            <span>Trading workflows</span>
            <span>Agentic AI</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
  <!-- BLOG FEED GRID -->
  <section class="blog-section">
    <div class="container">
      <% if (posts.length === 0) { %>
        <div class="text-center py-5 rounded-4" style="background: #ffffff; border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);">
          <i class="bi bi-journal-x fs-1 text-muted mb-3 d-block"></i>
          <h4 class="font-heading fw-bold">No posts published yet</h4>
          <p class="text-muted mb-0 max-width-500 mx-auto px-3">We are currently drafting insights and pricing recommendations. Check back soon for new content!</p>
        </div>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
          <% posts.forEach(post => { %>
            <div class="col">
              <article class="blog-card">
                <div class="blog-img-wrapper">
                  <% if (post.cover_image) { %>
                    <img src="<%= post.cover_image %>" alt="<%= post.title %>" class="blog-card-img" loading="lazy">
                  <% } else { %>
                    <div class="no-image-banner">
                      <i class="bi bi-image" style="font-size: 3rem;"></i>
                    </div>
                  <% } %>
                </div>
                
                <div class="blog-card-body">
                  <div class="blog-meta">
                    <span>
                      <i class="bi bi-calendar3"></i>
                      <%= new Date(post.published_at || post.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                    </span>
                    <span>
                      <i class="bi bi-clock"></i>
                      <% 
                        const words = post.content ? post.content.split(/\s+/).length : 0;
                        const readTime = Math.max(1, Math.ceil(words / 200));
                      %>
                      <%= readTime %> min read
                    </span>
                  </div>
                  
                  <h3 class="blog-card-title">
                    <a href="/resources/blog/<%= post.slug %>"><%= post.title %></a>
                  </h3>
                  
                  <p class="blog-card-text">
                    <%= post.excerpt || (post.content ? post.content.replace(/[#*`\n]/g, '').slice(0, 120) + '...' : '') %>
                  </p>
                  
                  <a href="/resources/blog/<%= post.slug %>" class="blog-read-more">
                    Read Article <i class="bi bi-arrow-right"></i>
                  </a>
                </div>
              </article>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
